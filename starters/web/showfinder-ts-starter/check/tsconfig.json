{
  // Конфігурація для npm run typecheck: src/ разом із перевірками типів check/*.check.ts,
  // без виводу файлів. Не змінюйте її.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": ["../src", "./*.ts"]
}
