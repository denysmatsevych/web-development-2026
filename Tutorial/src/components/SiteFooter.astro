---
/**
 * SiteFooter — condensed institute footer: a "Course" link group
 * (Tutorial home + outbound Lectures / Labs, same URLs as the header), a
 * contact link, and a copyright line. Flat `--color-footer-bg`, no gooey /
 * particle animation from the source design.
 */
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';

const year = new Date().getFullYear();

const courseLinks = [
  { label: 'Tutorial home', href: withBase('/'), external: false },
  { label: 'Lectures', href: site.lecturesUrl, external: true },
  { label: 'Labs', href: site.labsUrl, external: true },
];
---

<footer class="bg-footer-bg text-pure-white">
  <div class="mx-auto max-w-[100rem] px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2">
      <nav aria-label="Course">
        <p class="text-xs font-semibold uppercase tracking-widest text-pure-white/50">Course</p>
        <ul class="mt-4 space-y-2.5">
          {
            courseLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center gap-1 text-sm text-pure-white/80 transition-colors hover:text-brand-blue-light"
                >
                  {link.label}
                  {link.external && (
                    <svg
                      class="size-3 opacity-60"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="sm:text-right">
        <p class="text-xs font-semibold uppercase tracking-widest text-pure-white/50">Contact</p>
        <p class="mt-4">
          <a
            href={site.contactUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-pure-white/80 transition-colors hover:text-brand-blue-light"
          >
            {site.contactLabel}
          </a>
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-pure-white/10 pt-6 text-xs text-pure-white/50">
      © {year} {site.name}
    </p>
  </div>
</footer>
