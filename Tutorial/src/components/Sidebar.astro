---
/**
 * Sidebar — one Subject's full curriculum tree from `getNavTree(subject)`.
 *
 * Each Part is a native `<details>` (open when it holds the current article);
 * Chapters are labelled sub-groups; Articles are links, the current one marked
 * `aria-current="page"` and given a brand-blue active treatment. The Subject
 * switch itself lives in `SubjectTabs` under the header, not here — this tree is
 * scoped to the active Subject.
 *
 * Placement is `DocsLayout`'s job: a sticky, self-scrolling column on `lg+`; an
 * off-canvas drawer inside `#docs-sidebar` below that. `#docs-sidebar-close`
 * here and `#docs-sidebar-toggle` in the header are wired by
 * `src/scripts/docs.ts` (step 7).
 */
import { getNavTree, getSubject, type NavPart } from '@/lib/curriculum';

interface Props {
  /** `Subject.id` whose tree to render. */
  subject: string;
  /** Flat slug of the current article — highlights its link, opens its Part. */
  currentSlug?: string;
}

const { subject, currentSlug } = Astro.props;
const tree = await getNavTree(subject);
const subjectTitle = getSubject(subject)?.title ?? 'Tutorial';

const partHasCurrent = (part: NavPart): boolean =>
  part.chapters.some((chapter) => chapter.docs.some((doc) => doc.slug === currentSlug));
---

<nav class="sidebar" aria-label="Tutorial contents">
  <div class="sidebar__head">
    <p class="sidebar__title">{subjectTitle}</p>
    <button id="docs-sidebar-close" type="button" class="sidebar__close" aria-label="Close navigation">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <ul class="sidebar__parts">
    {
      tree.map((navPart) => (
        <li>
          <details class="sidebar__part" open={partHasCurrent(navPart)}>
            <summary class="sidebar__part-summary">
              <span class="sidebar__part-index">{navPart.index}</span>
              <span class="sidebar__part-name">{navPart.part.title}</span>
              <svg
                class="sidebar__chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </summary>

            <div class="sidebar__chapters">
              {navPart.chapters.map((navChapter) => (
                <div class="sidebar__chapter">
                  <p class="sidebar__chapter-title">
                    <span class="sidebar__chapter-index">
                      {navPart.index}.{navChapter.index}
                    </span>
                    {navChapter.chapter.title}
                  </p>
                  <ul class="sidebar__docs">
                    {navChapter.docs.map((doc) => (
                      <li>
                        <a
                          href={doc.href}
                          class="sidebar__link"
                          aria-current={doc.slug === currentSlug ? 'page' : undefined}
                        >
                          {doc.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .sidebar {
    font-size: 0.875rem;
  }

  .sidebar__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .sidebar__title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted-foreground);
  }

  .sidebar__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    color: var(--foreground);
  }

  .sidebar__close svg {
    width: 1rem;
    height: 1rem;
  }

  .sidebar__close:hover {
    background: var(--accent);
  }

  @media (min-width: 1024px) {
    .sidebar__close {
      display: none;
    }
  }

  .sidebar__parts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar__part {
    border-top: 1px solid var(--sidebar-border);
  }

  .sidebar__parts > li:last-child .sidebar__part {
    border-bottom: 1px solid var(--sidebar-border);
  }

  .sidebar__part-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--sidebar-foreground);
  }

  .sidebar__part-summary::-webkit-details-marker {
    display: none;
  }

  .sidebar__part-summary:hover {
    color: var(--foreground);
  }

  .sidebar__part-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.35rem;
    border-radius: var(--radius-sm);
    background: var(--sidebar-accent);
    color: var(--sidebar-accent-foreground);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .sidebar__part-name {
    flex: 1;
  }

  .sidebar__chevron {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--muted-foreground);
    transition: transform 0.2s ease;
  }

  .sidebar__part[open] .sidebar__chevron {
    transform: rotate(90deg);
  }

  .sidebar__chapters {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.25rem 0 0.85rem 0.4rem;
  }

  .sidebar__chapter-title {
    margin: 0 0 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .sidebar__chapter-index {
    margin-right: 0.35rem;
  }

  .sidebar__docs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar__link {
    display: block;
    padding: 0.3rem 0.6rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--muted-foreground);
    text-decoration: none;
    line-height: 1.4;
  }

  .sidebar__link:hover {
    color: var(--foreground);
    background: var(--sidebar-accent);
  }

  .sidebar__link[aria-current='page'] {
    color: var(--foreground);
    font-weight: 600;
    border-left-color: var(--color-brand-blue);
    background: color-mix(in oklab, var(--color-brand-blue) 12%, transparent);
  }
</style>
