---
/**
 * Legacy task URL — redirect `/labs/<lab>/task/` to the course-prefixed route.
 */
import { getCourses } from '@/data/courses';
import { getLabs, getTasks, splitId, taskHref } from '@/lib/labs';

export async function getStaticPaths() {
  const course = getCourses().find(({ slug }) => slug === 'web-development');
  if (!course) return [];

  const [labs, tasks] = await Promise.all([
    getLabs(course.slug),
    getTasks(course.slug),
  ]);
  const publishedLabIds = new Set(labs.map(({ id }) => id));

  return tasks
    .filter(({ id }) => publishedLabIds.has(id))
    .map((task) => ({
      params: { lab: splitId(task.id).slug },
      props: { destination: taskHref(course.slug, splitId(task.id).slug) },
    }));
}

return Astro.redirect(Astro.props.destination, 301);
---