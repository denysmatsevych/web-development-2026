---
/**
 * Legacy lab URL — redirect `/labs/<lab>/` to its course-prefixed route.
 */
import { getLabs, labHref, splitId } from '@/lib/labs';
import { LEGACY_COURSE } from '@/data/courses';
import { defaultLocale } from '@/i18n';

export async function getStaticPaths() {
  const labs = await getLabs(LEGACY_COURSE, defaultLocale);
  return labs.map((lab) => {
    const { slug } = splitId(lab.id);
    return {
      params: { lab: slug },
      props: { destination: labHref(defaultLocale, LEGACY_COURSE, slug) },
    };
  });
}

return Astro.redirect(Astro.props.destination, 301);
---