---
/**
 * Legacy lab URL — redirect `/labs/<lab>/` to its course-prefixed route.
 */
import { getCourses } from '@/data/courses';
import { getLabs, labHref, splitId } from '@/lib/labs';

export async function getStaticPaths() {
  const course = getCourses().find(({ slug }) => slug === 'web-development');
  if (!course) return [];

  const labs = await getLabs(course.slug);
  return labs.map((lab) => {
    const { slug } = splitId(lab.id);
    return {
      params: { lab: slug },
      props: { destination: labHref(course.slug, slug) },
    };
  });
}

return Astro.redirect(Astro.props.destination, 301);
---