---
/**
 * ЛР-7 auto-check (beta) — `/labs/lab-7/check/`. The instructor pastes the URL
 * of a student's deployed Courtly page; progress and the report (a mark on
 * the 12-point scale) open in a modal dialog. All checking happens in
 * the browser; the engine and its trade-offs are documented in
 * src/scripts/courtly-check.ts.
 *
 * Confirmable rows take the instructor's verdict: the match with the mockup at
 * each width — «Виконано / Частково / Не виконано», since no script can judge
 * a visual match; the Lighthouse categories — a «Виконано» checkbox, since
 * PageSpeed Insights is often out of quota and the bar is a single ≥ 90
 * (scoring rules: `withVerdicts()` in the engine). "Порівняти" opens the
 * shared comparison viewer (`CourtlyCompare`, full layout): the mockup capture
 * beside the student's page, scroll aligned on section starts, with the lab's
 * requirements the page misses outlined and listed — hints for the verdict,
 * which stays the instructor's. "Скопіювати звіт" puts the report on the
 * clipboard formatted for a reply to the student. "Сформувати звіт", once
 * Lighthouse has landed and every width is judged, opens the student's
 * report page (`report.astro`) with the result carried in its link.
 *
 * Instructor-only by obscurity: nothing links here and the page is
 * `noindex`, but anyone who knows the URL can use it. Limiting students to
 * one attempt needs a backend, so there is no limit.
 *
 * Static route beside `[lab].astro` / `[lab]/task.astro`: only ЛР-7 has a
 * checker, so a collection field would be ceremony.
 */
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CourtlyCompare from "@/components/CourtlyCompare.astro";
import LabHeader from "@/components/LabHeader.astro";
import LabLayout from "@/layouts/LabLayout.astro";
import { labHref, taskHref } from "@/lib/labs";
import { withBase } from "@/lib/paths";

const title = "Автоматична перевірка Courtly";
const summary =
  "Вставте адресу опублікованої сторінки студента. Перевірка відкриє її на 320, 375, 768 і 1440 px, прочитає HTML і CSS та складе звіт з оцінкою за 12-бальною шкалою.";

const crumbs = [
  { label: "Labs", href: withBase("/labs/") },
  { label: "ЛР-7", href: labHref("lab-7") },
  { label: "Автоперевірка", href: withBase("/labs/lab-7/check/") },
];

const headings = [
  { depth: 2, slug: "scope", text: "Що перевіряється" },
  { depth: 2, slug: "mark", text: "Як рахується оцінка" },
  { depth: 2, slug: "student-report", text: "Звіт для студента" },
  { depth: 2, slug: "limits", text: "Обмеження бета-версії" },
];
---

<LabLayout
  title={`${title} (бета) — ЛР-7`}
  description={summary}
  lang="uk"
  headings={headings}
  noindex
>
  <Breadcrumbs items={crumbs} />

  <LabHeader
    eyebrow="Бета · Проміжний контроль №1 · ЛР-7"
    title={title}
    summary={summary}
  />

  <div class="cc" data-cc>
    <form class="cc-form" data-cc-form novalidate>
      <label class="cc-form__label" for="cc-url"
        >Адреса опублікованої сторінки</label
      >
      <div class="cc-form__row">
        <input
          id="cc-url"
          class="cc-form__input"
          name="url"
          type="url"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          required
          placeholder="https://username.github.io/courtly/"
          aria-describedby="cc-hint cc-error"
        />
        <button class="cc-form__submit" type="submit" data-cc-submit
          >Перевірити</button
        >
      </div>
      <p id="cc-hint" class="cc-form__hint">
        GitHub Pages або Vercel. Сторінка має відкриватися без авторизації.
        Посилання виду <code>?url=&lt;адреса&gt;</code> запускає перевірку одразу.
      </p>
      <p id="cc-error" class="cc-form__error" data-cc-error hidden></p>
      <button class="cc-reopen" type="button" data-cc-reopen hidden
        >Відкрити результат</button
      >
    </form>

    <dialog class="cc-dialog" data-cc-dialog aria-labelledby="cc-dialog-title">
      <header class="cc-dialog__head">
        <div class="cc-dialog__heading">
          <h2 id="cc-dialog-title" class="cc-dialog__title">
            Автоматична перевірка
          </h2>
          <p class="cc-dialog__url">
            <a data-cc-url target="_blank" rel="noopener noreferrer"></a>
          </p>
        </div>
        <button
          class="cc-dialog__close"
          type="button"
          data-cc-close
          aria-label="Закрити"
          autofocus
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </header>

      <div class="cc-dialog__body" data-cc-body>
        <p class="cc-status" data-cc-status role="status" aria-live="polite"></p>
        <p class="cc-run-error" data-cc-run-error role="alert" hidden></p>
        <p class="visually-hidden" data-cc-announce aria-live="polite"></p>

        <section class="cc-report" data-cc-report aria-label="Звіт" hidden>
          <div class="cc-summary">
            <p class="cc-mark">
              <span class="cc-mark__value" data-cc-mark>—</span>
              <span class="cc-mark__max">/ 12</span>
            </p>
            <div class="cc-summary__text">
              <p class="cc-summary__title" data-cc-title>Оцінка</p>
              <p class="cc-summary__meta" data-cc-meta></p>
              <div class="cc-bar" aria-hidden="true"><span data-cc-bar></span></div>
            </div>
            <div class="cc-actions">
              <button
                class="cc-copy cc-copy--primary"
                type="button"
                data-cc-make-report
                aria-describedby="cc-report-state"
                disabled>Сформувати звіт</button
              >
              <button class="cc-copy" type="button" data-cc-copy
                >Скопіювати звіт</button
              >
              <button
                class="cc-copy cc-copy--icon"
                type="button"
                data-cc-copy-link
                aria-label="Скопіювати посилання на звіт"
                title="Скопіювати посилання на звіт"
              >
                <svg
                  class="cc-copy__link"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                >
                  <path
                    d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                  ></path>
                  <path
                    d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                  ></path>
                </svg>
                <svg
                  class="cc-copy__done"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
              </button>
            </div>
          </div>
          <p
            id="cc-report-state"
            class="cc-report-state"
            data-cc-report-state
            aria-live="polite"
          >
          </p>
          <p class="cc-note">
            Відповідність макету оцінюєте ви: «Виконано», «Частково» (половина
            балів) або «Не виконано»; категорії Lighthouse — прапорцем
            «Виконано». Пункт без оцінки дає 0 балів, тож оцініть їх до того,
            як копіювати звіт. Лист і опис роботи з AI в оцінку не входять.
          </p>
          <div class="cc-groups-bar">
            <button class="cc-toggle-all" type="button" data-cc-toggle-all
              >Розгорнути все</button
            >
          </div>
          <div data-cc-groups></div>
        </section>
      </div>
    </dialog>

    <dialog
      class="cc-compare"
      data-cc-compare
      aria-labelledby="cc-compare-title"
    >
      <CourtlyCompare layout="full" headingLevel={3} autofocus>
        <h2 slot="title" id="cc-compare-title" class="cc-dialog__title">
          Порівняння з макетом
        </h2>
        <Fragment slot="tools">
          <div data-cc-compare-verdict></div>
          <button
            class="cc-dialog__close"
            type="button"
            data-cc-compare-close
            aria-label="Закрити порівняння"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </Fragment>
      </CourtlyCompare>
    </dialog>
  </div>

  <article class="doc-content">
    <h2 id="scope">Що перевіряється</h2>
    <p>
      Критерії — з тексту <a href={labHref("lab-7")}>лабораторної роботи</a> і <a
        href={taskHref("lab-7")}
      >
        макета
      </a>. Сторінка завантажується з опублікованої адреси, як у браузері відвідувача:
    </p>
    <ul>
      <li>
        <strong>Адаптивність</strong> — сторінка рендериться на 320, 375, 768 і 1440
        px; вимірюються горизонтальний scroll, колонки карток, featured card, header,
        hero, форма й кроки.
      </li>
      <li>
        <strong>Розмітка</strong> — <code>id</code> секцій, посилання, форма, картки,
        кнопки «Забронювати», landmarks, заголовки, <code>alt</code>,
        зображення.
      </li>
      <li>
        <strong>CSS</strong> — значення токенів, <code>clamp()</code>,
        breakpoints, Grid, Flexbox, Montserrat з кирилицею, перевизначення <code
          >--color-focus</code
        >.
      </li>
      <li>
        <strong>Mobile menu</strong> — скрипт сторінки запускається в ізольованому фреймі
        на 375 px, кнопка натискається двічі, перевіряється <code
          >aria-expanded</code
        >.
      </li>
      <li>
        <strong>SEO</strong> — meta, canonical, Open Graph, favicon, <code
          >robots.txt</code
        > і
        <code>sitemap.xml</code>.
      </li>
      <li>
        <strong>Відповідність макету</strong> — вручну: «Порівняти» показує
        макет і сторінку студента поруч на 1440, 768 і 375 px і позначає вимоги
        з тексту лабораторної та макета, яких сторінка не виконує на цій
        ширині. Позначки — підказки; кожну ширину оцініть самі: «Виконано» — як у макеті, з дрібними відхиленнями у відступах
        і розмірах; «Частково» — структура та адаптивність правильні, але
        окремі елементи помітно відрізняються від макета; «Не виконано» — інше
        компонування або бракує частин сторінки.
      </li>
      <li>
        <strong>Lighthouse</strong> — Performance, Accessibility, Best Practices
        і SEO не нижче 90 — через PageSpeed Insights (Mobile), якщо сервіс
        доступний; інакше категорії зараховуються прапорцем «Виконано» за
        скриншотом студента.
      </li>
    </ul>

    <h2 id="mark">Як рахується оцінка</h2>
    <p>
      Кожна перевірка має вагу: «виконано» — повна вага, «частково» — половина,
      «не виконано» — 0. Автоматичні перевірки, які не вдалося виконати, в
      оцінку не входять. Виняток — пункти, які оцінюєте ви (три ширини макета
      й чотири категорії Lighthouse з прапорцем «Виконано»): пункт без вашої
      оцінки рахується як «не виконано», якщо PageSpeed Insights не оцінив
      його сам. Відсоток
      переводиться у 12-бальну шкалу й округлюється: 10–12 — високий рівень,
      7–9 — достатній, 4–6 — середній, 1–3 — початковий.
    </p>

    <h2 id="student-report">Звіт для студента</h2>
    <p>
      Коли Lighthouse завершився й відповідність макету оцінено на всіх трьох
      ширинах, «Сформувати звіт» відкриває окрему сторінку для студента:
      оцінка, усі пункти з вашими оцінками й коментарями та порівняння
      сторінки з макетом, де позначено вимоги лабораторної, яких сторінка не
      виконує. Звіт зберігається в самому посиланні, тож показує результат
      на момент перевірки; порівняння завжди показує сторінку такою, якою вона
      є зараз. Якщо після цього змінити оцінку, сформуйте звіт ще раз.
      Посилання також додається до «Скопіювати звіт».
    </p>

    <h2 id="limits">Обмеження бета-версії</h2>
    <ul>
      <li>
        Відповідність макету не оцінюється автоматично: попіксельне порівняння
        незалежної верстки з макетом ненадійне, а незначні відхилення у
        відступах і розмірах дозволені. Переглядач показує обидві версії поруч
        і позначає письмові вимоги, яких сторінка не виконує; рішення — за
        викладачем.
      </li>
      <li>
        Якщо PageSpeed Insights недоступний, рядки Lighthouse без прапорця
        рахуються як невиконані — звірте скриншот студента або запустіть
        Lighthouse у DevTools, як описано в §4, і позначте виконані категорії.
      </li>
      <li>
        Оцінки й прапорці не зберігаються: після перезавантаження сторінки
        або нової перевірки їх треба поставити знову.
      </li>
      <li>
        Помилка перевірки можлива: сумнівні пункти варто переглянути у DevTools
        на сторінці студента.
      </li>
    </ul>
  </article>
</LabLayout>

<script>
  import {
    CheckError,
    GROUPS,
    STATUS_ICON as ICON,
    STATUS_LABEL as LABEL,
    groupScore,
    inspect,
    normalizeUrl,
    scoreChecks,
    summaryLine,
    withVerdicts,
    type Check,
    type GroupId,
    type Status,
    type Verdict,
  } from "@/scripts/courtly-check";
  import { mountCompare } from "@/scripts/courtly-compare";
  import { reportHref } from "@/scripts/courtly-report";

  const root = document.querySelector<HTMLElement>("[data-cc]")!;
  const form = root.querySelector<HTMLFormElement>("[data-cc-form]")!;
  const input = form.querySelector<HTMLInputElement>("#cc-url")!;
  const submit = form.querySelector<HTMLButtonElement>("[data-cc-submit]")!;
  const error = form.querySelector<HTMLElement>("[data-cc-error]")!;
  const reopen = form.querySelector<HTMLButtonElement>("[data-cc-reopen]")!;
  const dialog = root.querySelector<HTMLDialogElement>("[data-cc-dialog]")!;
  const body = dialog.querySelector<HTMLElement>("[data-cc-body]")!;
  const status = dialog.querySelector<HTMLElement>("[data-cc-status]")!;
  const runError = dialog.querySelector<HTMLElement>("[data-cc-run-error]")!;
  const announce = dialog.querySelector<HTMLElement>("[data-cc-announce]")!;
  const report = dialog.querySelector<HTMLElement>("[data-cc-report]")!;
  const groupsEl = report.querySelector<HTMLElement>("[data-cc-groups]")!;
  const toggleAll = report.querySelector<HTMLButtonElement>(
    "[data-cc-toggle-all]",
  )!;

  const PSI_KEY: string = import.meta.env.PUBLIC_PSI_API_KEY ?? "";

  let current: {
    pageUrl: string;
    checks: Check[];
    lighthouseDone: boolean;
    /** ISO timestamp of the run. */
    at: string;
    /** `srcdoc` for the viewer's frame. */
    preview: string;
  } | null = null;

  /**
   * Groups the viewer opened or closed by hand, by group id. `render()` runs
   * again when Lighthouse lands; this keeps their choice. Cleared per run.
   */
  const openState = new Map<string, boolean>();

  /** The instructor's verdicts on confirmable rows, by check id. Cleared per run. */
  const verdicts = new Map<string, Verdict>();

  /** The instructor's comments on judged mockup rows, by check id. Cleared per run. */
  const notes = new Map<string, string>();

  /** Checks as scored and reported, verdicts and comments applied. */
  const reported = () => withVerdicts(current!.checks, verdicts, notes);

  const makeReport = report.querySelector<HTMLButtonElement>(
    "[data-cc-make-report]",
  )!;
  const reportState = report.querySelector<HTMLElement>(
    "[data-cc-report-state]",
  )!;

  /**
   * The student's report last generated: the run it belongs to, the rows it
   * holds (as JSON, to tell when a verdict or comment changed since) and its
   * link (`/labs/lab-7/report/`).
   */
  let generated: { entry: object; rows: string; href: string } | null = null;

  /** The generated report's link, while it still matches the run and its verdicts. */
  function freshReport(): string | null {
    return generated &&
      generated.entry === current &&
      generated.rows === JSON.stringify(reported())
      ? generated.href
      : null;
  }

  /**
   * Why a report cannot be generated yet, or "": Lighthouse has to land and
   * each width needs a mockup verdict. Lighthouse ticks are optional — an
   * unticked row already counts as «Не виконано».
   */
  function reportBlocker(): string {
    if (!current?.lighthouseDone)
      return "Звіт для студента можна сформувати, коли завершиться Lighthouse.";
    const unjudged = reported().filter(
      (c) => c.confirmable === "verdict" && !c.manual && c.status !== "pass",
    );
    if (!unjudged.length) return "";
    const widths = unjudged.map((c) => c.id.replace("mockup-", "")).join(", ");
    return `Щоб сформувати звіт для студента, оцініть відповідність макету на ${widths} px.`;
  }

  /** «Сформувати звіт» and the line under the summary that explains it. */
  function syncReport() {
    const blocker = reportBlocker();
    const fresh = freshReport();
    makeReport.disabled = !!blocker;
    if (blocker) {
      reportState.textContent = blocker;
    } else if (fresh) {
      const link = el("a", undefined, "відкрити");
      link.href = fresh;
      link.target = "_blank";
      link.rel = "noopener";
      reportState.replaceChildren(
        "Звіт для студента сформовано: ",
        link,
        ". Посилання на нього додається до «Скопіювати звіт».",
      );
    } else if (generated?.entry === current) {
      reportState.textContent =
        "Оцінки змінилися після того, як звіт сформовано, — сформуйте його ще раз.";
    } else {
      reportState.textContent =
        "«Сформувати звіт» відкриє сторінку для студента: результати й порівняння з макетом.";
    }
  }

  /** Under a group with confirmable rows: how to judge them. */
  const VERDICT_HINT: Partial<Record<GroupId, string>> = {
    mockup:
      "Відкрийте «Порівняти» й оцініть кожну ширину: «Виконано» — як у макеті, з дрібними відхиленнями у відступах і розмірах; «Частково» — структура й адаптивність правильні, але окремі елементи помітно відрізняються; «Не виконано» — інше компонування. Без оцінки — 0 балів. Коментар під оцінкою потрапить у звіт для студента.",
    lighthouse:
      "Прапорець «Виконано» зараховує категорію вручну — за скриншотом Lighthouse з листа студента, якщо там 90 або більше. Без прапорця неоцінена категорія — 0 балів.",
  };

  /** Share of a group's weight earned, shown beside its title. */
  function groupScoreText(id: GroupId, rows: Check[]): string {
    if (id === "lighthouse" && !current!.lighthouseDone) return "виконується…";
    return groupScore(rows);
  }

  /** A `tick` row's «Виконано» box; locked when PageSpeed Insights already passed it. */
  function tickBox(check: Check): HTMLLabelElement {
    const label = el("label", "cc-manual");
    const box = el("input");
    box.type = "checkbox";
    box.dataset.ccTick = check.id;
    box.checked = check.status === "pass";
    box.disabled = check.status === "pass" && !check.manual;
    if (box.disabled) label.title = "Зараховано за PageSpeed Insights";
    label.append(box, "Виконано", el("span", "visually-hidden", `: ${check.title}`));
    return label;
  }

  /** Under a judged mockup row: the reason, which goes into the student's report. */
  function noteField(check: Check): HTMLInputElement {
    const field = el("input", "cc-check__note");
    field.type = "text";
    field.maxLength = 200;
    field.value = notes.get(check.id) ?? "";
    field.placeholder = "Коментар для студента (необов’язково)";
    field.setAttribute("aria-label", `Коментар: ${check.title}`);
    field.dataset.ccNote = check.id;
    return field;
  }

  const VERDICTS: Verdict[] = ["pass", "warn", "fail"];

  /**
   * «Виконано / Частково / Не виконано» radios for a `verdict` row; none
   * picked until the instructor judges it. Locked on «Виконано» when PageSpeed
   * Insights already passed the row. `name` must be unique in the document.
   */
  function verdictPicker(check: Check, name: string): HTMLFieldSetElement {
    const set = el("fieldset", "cc-verdict");
    set.append(el("legend", "visually-hidden", `Оцінка: ${check.title}`));
    const locked = check.status === "pass" && !check.manual;
    if (locked) set.title = "Зараховано за PageSpeed Insights";
    for (const verdict of VERDICTS) {
      const option = el("label", "cc-verdict__option");
      option.dataset.status = verdict;
      const radio = el("input");
      radio.type = "radio";
      radio.name = name;
      radio.value = verdict;
      radio.dataset.ccVerdict = check.id;
      radio.checked = check.manual ? check.status === verdict : locked && verdict === "pass";
      radio.disabled = locked;
      option.append(radio, LABEL[verdict]);
      set.append(option);
    }
    return set;
  }

  /** «Порівняти» on a mockup row: opens the viewer at that width. */
  function compareButton(check: Check): HTMLButtonElement {
    const button = el("button", "cc-copy", "Порівняти");
    button.type = "button";
    button.dataset.ccCompareOpen = check.id.replace("mockup-", "");
    button.append(el("span", "visually-hidden", `: ${check.title}`));
    return button;
  }

  const CHEVRON =
    '<svg class="cc-group__chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>';

  const formatDate = (iso: string) =>
    new Date(iso).toLocaleString("uk-UA", {
      dateStyle: "long",
      timeStyle: "short",
    });

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  /** The page being checked, under the dialog title. */
  function setUrl(pageUrl: string) {
    const link = dialog.querySelector<HTMLAnchorElement>("[data-cc-url]")!;
    link.href = pageUrl;
    link.textContent = pageUrl;
  }

  /** Progress line at the top of the dialog; `busy` shows the spinner. */
  function setStatus(text: string, busy: boolean) {
    status.textContent = text;
    status.toggleAttribute("data-busy", busy);
  }

  function render() {
    if (!current) return;
    const { pageUrl, lighthouseDone, at } = current;
    const checks = reported();
    const score = scoreChecks(checks);

    report.querySelector("[data-cc-mark]")!.textContent = String(score.mark);
    report.querySelector("[data-cc-title]")!.textContent = lighthouseDone
      ? "Оцінка"
      : "Попередня оцінка — чекаємо на Lighthouse";
    report.querySelector("[data-cc-meta]")!.textContent = summaryLine(checks);
    setUrl(pageUrl);
    report.querySelector<HTMLElement>("[data-cc-bar]")!.style.width =
      `${score.percent * 100}%`;
    report.dataset.level =
      score.mark >= 10
        ? "high"
        : score.mark >= 7
          ? "good"
          : score.mark >= 4
            ? "mid"
            : "low";

    groupsEl.replaceChildren(
      ...GROUPS.map((group) => {
        const rows = checks.filter((c) => c.group === group.id);
        const count = (status: Status) =>
          rows.filter((c) => c.status === status).length;

        // Collapsed by default when every row passed; open when there is
        // something to read — an unjudged confirmable row counts as failed.
        const section = el("details", "cc-group");
        section.dataset.group = group.id;
        section.open =
          openState.get(group.id) ?? count("fail") + count("warn") > 0;

        const head = el("summary", "cc-group__head");
        head.insertAdjacentHTML("afterbegin", CHEVRON);
        head.append(el("span", "cc-group__title", group.title));
        // Before click's default action, `open` still holds the old value.
        head.addEventListener("click", () =>
          openState.set(group.id, !section.open),
        );

        const meta = el("span", "cc-group__meta");
        for (const status of ["fail", "warn"] as const) {
          const n = count(status);
          if (!n) continue;
          const pill = el("span", "cc-pill", `${ICON[status]} ${n}`);
          pill.dataset.status = status;
          pill.setAttribute("aria-hidden", "true");
          meta.append(
            pill,
            el(
              "span",
              "visually-hidden",
              `, ${LABEL[status].toLowerCase()}: ${n}`,
            ),
          );
        }
        const scoreText = groupScoreText(group.id, rows);
        if (scoreText) meta.append(el("span", "cc-group__score", scoreText));
        head.append(meta);
        section.append(head);

        const hint = VERDICT_HINT[group.id];
        if (
          hint &&
          rows.some((c) => c.confirmable && (c.status !== "pass" || c.manual))
        ) {
          section.append(el("p", "cc-group__hint", hint));
        }

        const list = el("ul", "cc-list");
        if (group.id === "lighthouse" && !lighthouseDone) {
          const li = el("li", "cc-check");
          li.dataset.status = "skip";
          li.append(el("span", "cc-check__icon cc-spinner"));
          li.firstElementChild!.setAttribute("aria-hidden", "true");
          li.append(
            el(
              "div",
              "cc-check__body",
              "PageSpeed Insights запускає Lighthouse — це до хвилини.",
            ),
          );
          list.append(li);
        }
        for (const check of rows) {
          const li = el("li", "cc-check");
          li.dataset.status = check.status;
          const icon = el("span", "cc-check__icon", ICON[check.status]);
          icon.setAttribute("aria-hidden", "true");
          const body = el("div", "cc-check__body");
          const titleRow = el("p", "cc-check__title");
          titleRow.append(
            el("span", "visually-hidden", `${LABEL[check.status]}: `),
            check.title,
          );
          if (check.weight === 0)
            titleRow.append(
              el("span", "cc-check__info", " · не впливає на оцінку"),
            );
          body.append(titleRow);
          if (check.detail)
            body.append(el("p", "cc-check__detail", check.detail));
          if (check.confirmable === "verdict" && check.manual)
            body.append(noteField(check));
          li.append(icon, body);
          if (check.confirmable) {
            li.classList.add("cc-check--judged");
            const actions = el("div", "cc-check__actions");
            if (check.group === "mockup") actions.append(compareButton(check));
            actions.append(
              check.confirmable === "tick"
                ? tickBox(check)
                : verdictPicker(check, `cc-verdict-${check.id}`),
            );
            li.append(actions);
          }
          list.append(li);
        }
        section.append(list);
        return section;
      }),
    );
    syncToggleAll();
    syncReport();
    // Here rather than in run(): ticking a row changes the mark.
    if (lighthouseDone)
      setStatus(
        `Перевірку завершено: ${score.mark} з 12 (${formatDate(at)}).`,
        false,
      );
  }

  /** One button for all groups: expands unless every group is open. */
  function syncToggleAll() {
    const groups = [
      ...groupsEl.querySelectorAll<HTMLDetailsElement>("details"),
    ];
    const allOpen = groups.length > 0 && groups.every((d) => d.open);
    toggleAll.textContent = allOpen ? "Згорнути все" : "Розгорнути все";
    toggleAll.dataset.open = String(!allOpen);
  }

  /** Light-theme status colours for the mail copy: clients drop stylesheets, so inline. */
  const MAIL_COLOR: Record<Status, string> = {
    pass: "#177245",
    warn: "#9a5800",
    fail: "#c0262d",
    skip: "#6b6f76",
  };
  const MAIL_MUTED = "#6b6f76";

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"]/g, (ch) => `&#${ch.charCodeAt(0)};`);

  /**
   * The report as it goes into a reply to the student: HTML with inline
   * styles for mail clients, plain text for everything else. No `?url=`
   * link — this page is instructor-only — but the student's report page,
   * once one is generated and still matches the verdicts.
   */
  function mailReport(): { html: string; text: string } {
    const { pageUrl, lighthouseDone, at } = current!;
    const checks = reported();
    const score = scoreChecks(checks);
    const headline = `ЛР-7 · Автоматична перевірка: ${lighthouseDone ? "оцінка" : "попередня оцінка"} ${score.mark} / 12 (${Math.round(score.percent * 100)} %)`;
    const when = `Перевірено ${formatDate(at)}${lighthouseDone ? "" : " · Lighthouse ще не завершився"}`;
    const results = summaryLine(checks);
    const legend = (["pass", "warn", "fail", "skip"] as const)
      .map((s) => `${ICON[s]} ${LABEL[s].toLowerCase()}`)
      .join(" · ");
    const reportLink = freshReport();

    const text = [
      headline,
      pageUrl,
      ...(reportLink ? [`Звіт: ${reportLink}`] : []),
      when,
      results,
      legend,
      "",
    ];
    const html = [
      `<p style="margin:0 0 4px"><b style="font-size:16px">${escapeHtml(headline)}</b></p>`,
      `<p style="margin:0"><a href="${escapeHtml(pageUrl)}">${escapeHtml(pageUrl)}</a></p>`,
      reportLink
        ? `<p style="margin:0">Звіт: <a href="${escapeHtml(reportLink)}">результати й порівняння з макетом</a></p>`
        : "",
      `<p style="margin:0;color:${MAIL_MUTED}">${escapeHtml(when)}<br>${escapeHtml(results)}<br>${escapeHtml(legend)}</p>`,
      `<table cellpadding="0" cellspacing="0" style="border-collapse:collapse">`,
    ];
    for (const group of GROUPS) {
      const rows = checks.filter((c) => c.group === group.id);
      if (!rows.length) continue;
      const groupScore = groupScoreText(group.id, rows);
      text.push(groupScore ? `${group.title} — ${groupScore}` : group.title);
      html.push(
        `<tr><td colspan="2" style="padding:14px 0 4px"><b>${escapeHtml(group.title)}</b>${groupScore ? `<span style="color:${MAIL_MUTED}"> — ${escapeHtml(groupScore)}</span>` : ""}</td></tr>`,
      );
      for (const c of rows) {
        const info = c.weight === 0 ? " · не впливає на оцінку" : "";
        text.push(
          `  ${ICON[c.status]} ${c.title}${c.detail ? ` — ${c.detail}` : ""}${info}`,
        );
        const detailColor =
          c.status === "warn" || c.status === "fail"
            ? MAIL_COLOR[c.status]
            : MAIL_MUTED;
        html.push(
          `<tr><td style="padding:2px 8px 2px 0;vertical-align:top;font-weight:bold;color:${MAIL_COLOR[c.status]}">${ICON[c.status]}</td>` +
            `<td style="padding:2px 0">${escapeHtml(c.title)}` +
            (c.detail
              ? `<span style="color:${detailColor}"> — ${escapeHtml(c.detail)}</span>`
              : "") +
            (info ? `<span style="color:${MAIL_MUTED}">${info}</span>` : "") +
            `</td></tr>`,
        );
      }
      text.push("");
    }
    html.push("</table>");
    return { html: html.join(""), text: text.join("\n").trimEnd() };
  }

  /** Both flavours, so a mail client pastes it formatted; plain text if the browser cannot. */
  async function copyMailReport() {
    const { html, text } = mailReport();
    if (typeof ClipboardItem !== "undefined" && navigator.clipboard.write) {
      try {
        await navigator.clipboard.write([
          new ClipboardItem({
            "text/html": new Blob([html], { type: "text/html" }),
            "text/plain": new Blob([text], { type: "text/plain" }),
          }),
        ]);
        return;
      } catch {
        // fall through to plain text
      }
    }
    await navigator.clipboard.writeText(text);
  }

  /**
   * `?url=` link to this page. Opening it re-runs the check on the live site,
   * so the result cannot be edited on the way — but it reflects the site at
   * the time of the click, not of the first run.
   */
  function reportLink(pageUrl: string): string {
    const url = new URL(location.pathname, location.origin);
    url.searchParams.set("url", pageUrl);
    return url.href;
  }

  function setBusy(busy: boolean) {
    submit.disabled = busy;
    submit.textContent = busy ? "Перевіряю…" : "Перевірити";
    body.setAttribute("aria-busy", String(busy));
  }

  /**
   * Syntax problems (empty field, a github.com repo link) are reported under
   * the field; everything from the network on happens in the dialog.
   */
  async function run(raw: string) {
    error.hidden = true;
    input.removeAttribute("aria-invalid");
    let target: URL;
    try {
      target = normalizeUrl(raw);
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : String(err);
      error.hidden = false;
      input.setAttribute("aria-invalid", "true");
      input.focus();
      return;
    }

    setBusy(true);
    setUrl(target.href);
    report.hidden = true;
    runError.hidden = true;
    openState.clear();
    verdicts.clear();
    notes.clear();
    generated = null;
    setStatus("Підготовка…", true);
    reopen.hidden = false;
    if (!dialog.open) dialog.showModal();
    body.scrollTop = 0;

    try {
      const result = await inspect(
        raw,
        (text) => setStatus(text, true),
        PSI_KEY,
      );

      const entry = {
        pageUrl: result.pageUrl,
        checks: result.checks,
        lighthouseDone: false,
        at: new Date().toISOString(),
        preview: result.preview,
      };
      current = entry;
      history.replaceState(null, "", reportLink(result.pageUrl));

      render();
      report.hidden = false;
      setStatus(
        `Попередня оцінка ${scoreChecks(reported()).mark} з 12 — Lighthouse ще виконується.`,
        false,
      );
      setBusy(false);

      const extra = await result.lighthouse;
      if (current !== entry) return; // a newer run replaced this one
      entry.checks = [...entry.checks, ...extra];
      entry.lighthouseDone = true;
      render();
    } catch (err) {
      setStatus("", false);
      runError.textContent =
        err instanceof CheckError
          ? err.message
          : `Перевірка не вдалася: ${err instanceof Error ? err.message : String(err)}`;
      runError.hidden = false;
      setBusy(false);
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!submit.disabled) run(input.value);
  });

  reopen.addEventListener("click", () => dialog.showModal());

  toggleAll.addEventListener("click", () => {
    const open = toggleAll.dataset.open === "true";
    groupsEl.querySelectorAll<HTMLDetailsElement>("details").forEach((d) => {
      d.open = open;
      openState.set(d.dataset.group ?? "", open);
    });
    syncToggleAll();
  });
  // `toggle` does not bubble — capture it to keep the button label honest.
  groupsEl.addEventListener("toggle", syncToggleAll, true);

  /**
   * A verdict — or `null`, an untick — re-renders the report (mark, group
   * score, row) and the viewer's picker, and keeps the row's group open.
   */
  function setVerdict(id: string, verdict: Verdict | null) {
    if (verdict) verdicts.set(id, verdict);
    else verdicts.delete(id);
    const group = current?.checks.find((c) => c.id === id)?.group;
    if (group) openState.set(group, true);
    render();
    if (compare.open) renderCompareVerdict();
  }

  /** The checked radio of a verdict picker re-rendered inside `scope`. */
  const pickedRadio = (scope: Element, id: string) =>
    scope.querySelector<HTMLInputElement>(
      `[data-cc-verdict="${id}"]:checked`,
    );

  // Focus moves to the new copy of the radio or checkbox.
  groupsEl.addEventListener("change", (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement)) return;
    const { ccVerdict, ccTick } = input.dataset;
    if (ccVerdict) {
      setVerdict(ccVerdict, input.value as Verdict);
      pickedRadio(groupsEl, ccVerdict)?.focus();
    } else if (ccTick) {
      setVerdict(ccTick, input.checked ? "pass" : null);
      groupsEl
        .querySelector<HTMLInputElement>(`[data-cc-tick="${ccTick}"]`)
        ?.focus();
    }
  });

  // A comment changes only its row's detail: a full re-render would take the
  // focus away mid-word. The copied report reads `notes` when it is copied.
  groupsEl.addEventListener("input", (event) => {
    const field = event.target;
    if (!(field instanceof HTMLInputElement) || !field.dataset.ccNote) return;
    const id = field.dataset.ccNote;
    notes.set(id, field.value);
    const detail = field
      .closest(".cc-check")
      ?.querySelector<HTMLElement>(".cc-check__detail");
    const row = reported().find((c) => c.id === id);
    if (detail && row?.detail) detail.textContent = row.detail;
    syncReport();
  });

  groupsEl.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLElement>(
      "[data-cc-compare-open]",
    );
    if (button) openCompare(Number(button.dataset.ccCompareOpen));
  });
  dialog
    .querySelector("[data-cc-close]")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  report
    .querySelector("[data-cc-copy]")!
    .addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (!current) return;
      try {
        await copyMailReport();
        button.textContent = "Скопійовано";
      } catch {
        button.textContent = "Не вдалося скопіювати";
      }
      setTimeout(() => (button.textContent = "Скопіювати звіт"), 2000);
    });

  // The report opens in a new tab for a last look; its link is also on the
  // line under the summary, in case the browser blocks the tab.
  makeReport.addEventListener("click", async () => {
    if (!current || reportBlocker()) return;
    const entry = current;
    const checks = reported();
    const href = await reportHref({
      pageUrl: entry.pageUrl,
      at: entry.at,
      checks,
    });
    generated = { entry, rows: JSON.stringify(checks), href };
    syncReport();
    window.open(href, "_blank", "noopener");
  });

  report
    .querySelector("[data-cc-copy-link]")!
    .addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (!current) return;
      try {
        await navigator.clipboard.writeText(reportLink(current.pageUrl));
        button.dataset.copied = "true";
        announce.textContent = "Посилання на звіт скопійовано.";
      } catch {
        announce.textContent = "Не вдалося скопіювати посилання.";
      }
      setTimeout(() => {
        delete button.dataset.copied;
        announce.textContent = "";
      }, 2000);
    });

  // -------------------------------------------------------------------------
  // «Порівняти»: the shared viewer (`courtly-compare.ts`, full layout) — the
  // capture beside the student's page, with the lab's requirements the page
  // misses outlined and listed. The findings are hints; the verdict in the
  // toolbar is the instructor's.

  const compare = root.querySelector<HTMLDialogElement>("[data-cc-compare]")!;
  const compareVerdict = compare.querySelector<HTMLElement>(
    "[data-cc-compare-verdict]",
  )!;
  const viewer = mountCompare(
    compare.querySelector<HTMLElement>("[data-cv]")!,
  );

  /** The toolbar's picker: the verdict on the width being shown. */
  function renderCompareVerdict() {
    const check = reported().find((c) => c.id === `mockup-${viewer.width}`);
    compareVerdict.replaceChildren(
      ...(check ? [verdictPicker(check, "cc-compare-verdict")] : []),
    );
  }

  function openCompare(width: number) {
    if (!current) return;
    if (!compare.open) compare.showModal();
    viewer.show(current.preview, width);
  }

  // Every width change — a tab or `openCompare()` — re-renders the picker.
  compare.addEventListener("cv:view", renderCompareVerdict);
  compareVerdict.addEventListener("change", (event) => {
    const radio = event.target;
    if (!(radio instanceof HTMLInputElement) || !radio.dataset.ccVerdict) return;
    const id = radio.dataset.ccVerdict;
    setVerdict(id, radio.value as Verdict);
    pickedRadio(compareVerdict, id)?.focus();
  });
  compare
    .querySelector("[data-cc-compare-close]")!
    .addEventListener("click", () => compare.close());
  // A tick re-rendered the report, so the button that opened the viewer may
  // be gone; focus its current copy.
  compare.addEventListener("close", () =>
    groupsEl
      .querySelector<HTMLElement>(`[data-cc-compare-open="${viewer.width}"]`)
      ?.focus(),
  );

  // `?url=` prefills and runs — the address bar keeps it after a run, so a
  // report can be reopened or bookmarked as a link.
  const fromQuery = new URLSearchParams(location.search).get("url");
  if (fromQuery) {
    input.value = fromQuery;
    run(fromQuery);
  }
</script>


<style is:global>
  /* Global because the report rows are built at runtime and carry no scoped
     attribute; every selector is prefixed `.cc`. */
  /* Status colours: lab.css, shared with the report page. */
  .cc {
    --cc-pass: var(--lab-pass);
    --cc-warn: var(--lab-warn);
    --cc-fail: var(--lab-fail);
    --cc-skip: var(--muted-foreground);
    margin-block: 0 3rem;
  }

  .cc-form {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .cc-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .cc-form__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cc-form__input {
    flex: 1 1 16rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 0.85rem;
    border: 1px solid color-mix(in oklab, var(--foreground) 25%, transparent);
    border-radius: var(--radius-md);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: 1rem;
  }

  .cc-form__input:focus-visible,
  .cc-form__submit:focus-visible,
  .cc-copy:focus-visible,
  .cc-reopen:focus-visible,
  .cc-dialog__close:focus-visible,
  .cc-toggle-all:focus-visible,
  .cc-group__head:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 2px;
  }

  .cc-form__input[aria-invalid="true"] {
    border-color: var(--cc-fail);
  }

  .cc-form__submit {
    flex: 0 0 auto;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-brand-blue);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .cc-form__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .cc-form__hint {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .cc-form__error {
    margin: 0.6rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cc-fail);
  }

  .cc-reopen {
    margin-top: 0.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--brand-text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  /* The report is a modal: the page behind it should not scroll. */
  html:has(.cc-dialog[open]) {
    overflow: hidden;
  }

  .cc-dialog {
    /* Tailwind's preflight zeroes the UA `margin: auto` that centres a modal
       dialog — same fix as AcceptanceChecklist. */
    margin: auto;
    width: min(56rem, calc(100vw - 2rem));
    max-width: none;
    /* Fixed, so the box does not jump when the report replaces the spinner. */
    height: min(52rem, calc(100dvh - 2rem));
    max-height: none;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    color: var(--foreground);
