---
/**
 * Article page — one static route per Markdown file in
 * `src/content/docs/en/<subject>/`, at `/<subject>/<slug>`
 * (`/js/variables`, `/css/selectors`, `/html/forms`).
 *
 * `getStaticPaths` splits every `en/`-prefixed collection id
 * (`en/js/variables`) into its `subject` and flat `slug`: the Part / Chapter
 * hierarchy stays metadata, not URL path. The page pulls its neighbours and
 * breadcrumb trail (both scoped to the Subject) from `src/lib/curriculum.ts`
 * and composes the article body into `DocsLayout`, which wraps it with the
 * subject tabs, the subject's sidebar, the "on this page" rail, header and
 * footer.
 *
 * A `uk` locale later adds `src/pages/uk/[subject]/[...slug].astro` (or a
 * `[locale]` refactor) filtering on the `uk/` prefix instead.
 */
import { getCollection, render } from 'astro:content';

import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PrevNext from '@/components/PrevNext.astro';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getAdjacent, getBreadcrumbs, slugOf, subjectOf } from '@/lib/curriculum';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).filter((entry) => entry.id.startsWith('en/'));
  return docs.map((entry) => ({
    params: { subject: subjectOf(entry), slug: slugOf(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const subject = subjectOf(entry);
const slug = slugOf(entry);

// Body + h2/h3 headings for the "on this page" rail (Astro stamps the ids).
const { Content, headings } = await render(entry);

const [crumbs, adjacent] = await Promise.all([
  getBreadcrumbs(subject, slug),
  getAdjacent(subject, slug),
]);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.summary}
  subject={subject}
  slug={slug}
  headings={headings}
>
  <Breadcrumbs items={crumbs} />

  <header class="doc-header">
    <h1 class="doc-title">{entry.data.title}</h1>
    {entry.data.summary && <p class="doc-summary">{entry.data.summary}</p>}
  </header>

  <article class="doc-content">
    <Content />
  </article>

  <PrevNext prev={adjacent.prev} next={adjacent.next} />
</DocsLayout>

<style>
  .doc-header {
    margin-block: 1rem 2rem;
  }

  .doc-title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .doc-summary {
    margin: 0.75rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
</style>
