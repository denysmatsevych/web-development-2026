---
/**
 * Course hub — the `/` landing. The registry controls which course cards are
 * shown in development and production.
 */
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import CourseTitle from "@/components/CourseTitle.astro";
import {
  getCourseDescription,
  getCourseTitleParts,
  getCourses,
} from "@/data/courses";
import {
  defaultLocale,
  getEnabledLocales,
  localeAlternates,
  localeHref,
  useTranslations,
  type Locale,
} from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const courses = getCourses();

export function getStaticPaths() {
  return getEnabledLocales().map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  title={t.navigation.courses}
  description={t.site.description}
  locale={locale}
  alternates={localeAlternates("/")}
>
  <SiteHeader locale={locale} />

  <main id="main-content" class="home" tabindex="-1">
    <section class="hero" aria-labelledby="page-title">
      <p class="hero__eyebrow">{t.site.hubEyebrow}</p>
      <h1 id="page-title" class="hero__title">{t.site.name}</h1>
      <p class="hero__lead">{t.site.description}</p>
    </section>

    <ul class="courses" aria-label={t.course.availableCourses}>
      {
        courses.map((course) => (
          <li>
            <a
              href={localeHref(locale, `/${course.slug}/`)}
              class="course-card glass-panel"
              aria-labelledby={`course-${course.slug}-title`}
              aria-describedby={`course-${course.slug}-year course-${course.slug}-status course-${course.slug}-desc`}
            >
              <span class="course-card__top">
                <data
                  class="course-card__year"
                  id={`course-${course.slug}-year`}
                  value={`${course.year}`}
                >
                  {course.year}
                </data>
                <span
                  class:list={[
                    "course-card__status",
                    { "course-card__status--draft": course.status === "draft" },
                  ]}
                  id={`course-${course.slug}-status`}
                >
                  {course.status === "published" ? t.course.available : t.course.inDevelopment}
                </span>
              </span>
              <span class="course-card__body">
                <span class="course-card__title" id={`course-${course.slug}-title`}>
                  <CourseTitle parts={getCourseTitleParts(course, locale)} locale={locale} />
                </span>
                <span
                  class="course-card__description"
                  id={`course-${course.slug}-desc`}
                >
                  {getCourseDescription(course, locale)}
                </span>
              </span>
              <span class="course-card__bottom">
                <span class="course-card__action">
                  {course.status === "published"
                    ? t.course.goToCourse
                    : t.course.viewCourse}
                </span>
                <span class="course-card__arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .home {
    max-width: 80rem;
    width: 100%;
    margin-inline: auto;
    padding: 3.5rem 1rem;
  }

  .hero {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .hero__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--brand-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0 0 1rem;
    color: var(--foreground);
    font-size: clamp(2.5rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .hero__lead {
    max-width: 42rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.75;
  }

  .courses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .course-card__top,
  .course-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .course-card__bottom {
    margin-top: 0.75rem;
  }
  .course-card__year {
    color: var(--brand-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .course-card__status {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--brand-text);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .course-card__status--draft {
    color: var(--muted-foreground);
  }

  .course-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
  }

  .course-card__title {
    color: var(--foreground);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .course-card__description {
    margin-top: 0.15rem;
    color: var(--muted-foreground);
    font-size: 0.975rem;
    line-height: 1.65;
  }

  .course-card__action {
    color: var(--brand-text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .course-card__arrow {
    color: var(--brand-text);
    font-size: 1.25rem;
  }

  @media (min-width: 640px) {
    .home {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 680px) {
    .course-card {
      padding: 1.75rem;
    }
  }
  @media (min-width: 980px) {
    .courses {
      grid-template-columns: repeat(auto-fit, minmax(300px, 0.5fr));
    }
  }
</style>
