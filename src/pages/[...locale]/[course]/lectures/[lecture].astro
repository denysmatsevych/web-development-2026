---
/**
 * Lecture deck — one static route per course lecture at
 * `/<course>/lectures/<slug>`. Fullscreen `DeckLayout`; `deck.ts` wires
 * keyboard navigation, the progress bar, speaker notes, fullscreen and theme.
 */
import DeckChrome from '@/components/DeckChrome.astro';
import SlideView from '@/components/Slide.astro';
import DeckLayout from '@/layouts/DeckLayout.astro';
import {
  getCourseDeckLabel,
  getCourseTitleParts,
  getCourses,
  type Course,
} from '@/data/courses';
import { getLectures, type LectureMeta } from '@/data/lectures';
import {
  defaultLocale,
  getEnabledLocales,
  localeAlternates,
  localeHref,
  useTranslations,
  type Locale,
} from '@/i18n';

interface Props {
  course: Course;
  lecture: LectureMeta;
  locale: Locale;
  /** Index in the course's registry list. */
  position: number;
}

const { course, lecture, position, locale } = Astro.props;
const { slides } = lecture;
const t = useTranslations(locale);
const alternates = localeAlternates(`/${course.slug}/lectures/${lecture.slug}/`);
const courseTitleParts = getCourseTitleParts(course, locale);
const courseTitle = courseTitleParts.map(p => p.text).join(' ');
const lectureLabel = `${t.deck.lecture} ${lecture.number}`;

export async function getStaticPaths() {
  return getCourses().flatMap((course) =>
    getEnabledLocales().flatMap((locale) =>
      getLectures(course.slug).map((lecture, position) => ({
        params: {
          locale: locale === defaultLocale ? undefined : locale,
          course: course.slug,
          lecture: lecture.slug,
        },
        props: { course, lecture, position, locale },
      })),
    ),
  );
}

/** Adjacent decks for the top-left stepper (registry order = lecture order). */
const lectures = getLectures(course.slug);
const toLink = (entry: LectureMeta | undefined) =>
  entry && {
    href: localeHref(locale, `/${course.slug}/lectures/${entry.slug}/`),
    title: entry.title,
    label: `${t.deck.lecture} ${entry.number}`,
  };
const prevLecture = toLink(lectures[position - 1]);
const nextLecture = toLink(lectures[position + 1]);
---

<DeckLayout
  title={lecture.title}
  titleSuffix={courseTitle}
  locale={locale}
  alternates={alternates}
>
  <main
    id="deck"
    class="deck flex h-dvh w-screen snap-x snap-mandatory overflow-x-auto overflow-y-hidden"
    tabindex="-1"
    lang={lecture.lang === locale ? undefined : lecture.lang}
  >
    {
      slides.map((slide, index) => (
        <SlideView
          slide={slide}
          index={index}
          total={slides.length}
          lectureLabel={lectureLabel}
          courseLabel={getCourseDeckLabel(course, locale)}
          locale={locale}
          contentLang={lecture.lang}
        />
      ))
    }
  </main>

  <DeckChrome
    total={slides.length}
    lecturesHref={localeHref(locale, `/${course.slug}/lectures/`)}
    prevLecture={prevLecture}
    nextLecture={nextLecture}
    alternates={alternates} 
    courseSlug={course.slug}
  />

  <script>
    import { initDeck } from '@/scripts/deck';

    initDeck();
  </script>
</DeckLayout>
