---
/**
 * ТЗ page — one static route per published task at
 * `/<course>/labs/<lab>/task`. The task id is the owning lab's, so the route
 * is generated only when that lab is itself published.
 *
 * The lab page and this file coexist at distinct route patterns.
 *
 * A brief that names a `mockup` composes it above `.doc-content` — its §1
 * describes the target design, and a live render beats a screenshot in both
 * themes. ЛР-7's `courtly` mockup is the exception: a whole landing page in its
 * own brand colours, so it ships as captures (see docs/web/lab-7/README.md). A
 * brief whose practical part is an audit of supplied code names none, and
 * renders body-first.
 */
import { render } from "astro:content";

import AcceptanceChecklist from "@/components/AcceptanceChecklist.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CourtlyMockup from "@/components/CourtlyMockup.astro";
import LabHeader from "@/components/LabHeader.astro";
import MockupLightbox from "@/components/MockupLightbox.astro";
import LabLayout from "@/layouts/LabLayout.astro";
import { getCourseTitleParts, getCourses, type Course } from "@/data/courses";
import {
  getLabs,
  getTasks,
  labHref,
  labNumber,
  splitId,
  taskHref,
  getLabAlternates,
  type LabEntry,
  type TaskEntry,
} from "@/lib/labs";
import {
  defaultLocale,
  getEnabledLocales,
  localeHref,
  useTranslations,
  type Locale,
} from "@/i18n";

export async function getStaticPaths() {
  const paths = await Promise.all(
    getCourses().flatMap((course) =>
      getEnabledLocales().map(async (locale) => {
        const [labs, defaultLabs, tasks] = await Promise.all([
          getLabs(course.slug, locale),
          getLabs(course.slug, defaultLocale),
          getTasks(course.slug, locale),
        ]);
        const bySlug = new Map(
          [...defaultLabs, ...labs].map((lab) => [splitId(lab.id).slug, lab]),
        );

        // A brief whose lab is a draft (or missing in every language) gets no
        // route. A lab with no version in this language is read from the
        // default language, and the page links to that version.
        return tasks.flatMap((task) => {
          const lab = bySlug.get(splitId(task.id).slug);
          return lab
            ? [
                {
                  params: {
                    locale: locale === defaultLocale ? undefined : locale,
                    course: course.slug,
                    lab: splitId(task.id).slug,
                  },
                  props: { course, task, lab, locale },
                },
              ]
            : [];
        });
      }),
    ),
  );
  return paths.flat();
}

interface Props {
  course: Course;
  task: TaskEntry;
  lab: LabEntry;
  locale: Locale;
}

const { course, task, lab, locale } = Astro.props;
const { data } = task;
const contentLang = splitId(task.id).locale;
const t = useTranslations(locale);
const courseTitleParts = getCourseTitleParts(course, locale);
const courseTitle = courseTitleParts.map((p) => p.text).join(" ");
const taskLabel = data.label ?? t.labs.taskLabel;
const taskLabelLang = data.label !== undefined ? contentLang : locale;
const taskEyebrow = data.eyebrow ?? t.labs.taskEyebrow;
const taskEyebrowLang = data.eyebrow !== undefined ? contentLang : locale;
const labLabel = t.labs.labNumber.replace("{number}", labNumber(lab));

const { Content, headings } = await render(task);
const { slug } = splitId(task.id);
const alternates = await getLabAlternates(course.slug, slug, 'task');

const crumbs = [
  {
    label: courseTitle,
    href: localeHref(locale, `/${course.slug}/`),
    parts: getCourseTitleParts(course, locale),
  },
  {
    label: t.navigation.labs,
    href: localeHref(locale, `/${course.slug}/labs/`),
  },
  { label: labLabel, href: labHref(splitId(lab.id).locale, course.slug, slug), lang: splitId(lab.id).locale },
  {
    label: taskLabel,
    href: taskHref(locale, course.slug, slug),
    lang: taskLabelLang,
  },
];
---

<LabLayout
  title={data.title}
  titleSuffix={courseTitle}
  courseSlug={course.slug}
  locale={locale}
  description={data.summary}
  headings={headings}
  headingsLang={contentLang !== locale ? contentLang : undefined}
  alternates={alternates}
>
  <Breadcrumbs items={crumbs} locale={locale} />

  <LabHeader
    eyebrow={taskEyebrow}
    eyebrowLang={taskEyebrowLang === locale ? undefined : taskEyebrowLang}
    eyebrowSuffix={labLabel}
    eyebrowSuffixLang={undefined}
    title={data.title}
    summary={data.summary}
    contentLang={contentLang !== locale ? contentLang : undefined}
    handout={data.handout}
  />

  {
    data.goal && (
      <p class="task-goal">
        <strong>{t.labs.taskGoal}</strong>{" "}
        <span lang={contentLang === locale ? undefined : contentLang}>
          {data.goal}
        </span>
      </p>
    )
  }

  {
    data.acceptance.length > 0 && (
      <AcceptanceChecklist items={data.acceptance} itemsLang={contentLang} />
    )
  }

  {
    data.mockup === "pricing" && (
      <figure class="task-preview">
        <MockupLightbox />
        <figcaption>{t.labs.previewPricing}</figcaption>
      </figure>
    )
  }

  {
    data.mockup === "courtly" && (
      <figure class="task-preview">
        <CourtlyMockup />
        <figcaption>{t.labs.previewCourtly}</figcaption>
      </figure>
    )
  }

  <article
    class="doc-content"
    lang={contentLang === locale ? undefined : contentLang}
  >
    <Content />
  </article>

  <nav class="task-back" aria-label={t.navigation.labs}>
    <a href={labHref(locale, course.slug, slug)} rel="up"
      >{t.labs.taskBack.replace("{number}", labNumber(lab))}</a
    >
  </nav>
</LabLayout>

<style>
  /* The brief's "Мета практичної частини" box — a lead, not body copy, so it
     sits outside `.doc-content` and carries its own rule. */
  .task-goal {
    margin: 0 0 1.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-brand-blue);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .task-goal strong {
    color: var(--foreground);
  }

  .task-preview {
    margin: 0 0 2.5rem;
  }

  .task-preview figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--muted-foreground);
  }

  .task-back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .task-back a {
    color: var(--brand-text);
    text-decoration: none;
  }

  .task-back a:hover {
    text-decoration: underline;
  }
</style>
