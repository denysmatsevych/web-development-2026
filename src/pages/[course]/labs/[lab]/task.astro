---
/**
 * ТЗ page — one static route per published task at
 * `/<course>/labs/<lab>/task`. The task id is the owning lab's, so the route
 * is generated only when that lab is itself published.
 *
 * The lab page and this file coexist at distinct route patterns.
 *
 * A brief that names a `mockup` composes it above `.doc-content` — its §1
 * describes the target design, and a live render beats a screenshot in both
 * themes. ЛР-7's `courtly` mockup is the exception: a whole landing page in its
 * own brand colours, so it ships as captures (see docs/web/lab-7/README.md). A
 * brief whose practical part is an audit of supplied code names none, and
 * renders body-first.
 */
import { render } from "astro:content";

import AcceptanceChecklist from "@/components/AcceptanceChecklist.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CourtlyMockup from "@/components/CourtlyMockup.astro";
import LabHeader from "@/components/LabHeader.astro";
import MockupLightbox from "@/components/MockupLightbox.astro";
import LabLayout from "@/layouts/LabLayout.astro";
import { getCourses, type Course } from "@/data/courses";
import {
  getLabs,
  getTasks,
  labHref,
  labNumber,
  splitId,
  taskHref,
  type LabEntry,
  type TaskEntry,
} from "@/lib/labs";
import { withBase } from "@/lib/paths";

export async function getStaticPaths() {
  const paths = await Promise.all(
    getCourses().map(async (course) => {
      const [labs, tasks] = await Promise.all([
        getLabs(course.slug),
        getTasks(course.slug),
      ]);
      const byId = new Map(labs.map((lab) => [lab.id, lab]));

      // A brief whose lab is a draft (or missing) gets no route.
      return tasks.flatMap((task) => {
        const lab = byId.get(task.id);
        return lab
          ? [
              {
                params: { course: course.slug, lab: splitId(task.id).slug },
                props: { course, task, lab },
              },
            ]
          : [];
      });
    }),
  );
  return paths.flat();
}

interface Props {
  course: Course;
  task: TaskEntry;
  lab: LabEntry;
}

const { course, task, lab } = Astro.props;
const { data } = task;

const { Content, headings } = await render(task);
const { slug } = splitId(task.id);

const crumbs = [
  { label: course.title, href: withBase(`/${course.slug}/`) },
  { label: "Labs", href: withBase(`/${course.slug}/labs/`) },
  { label: `ЛР-${labNumber(lab)}`, href: labHref(course.slug, slug) },
  { label: data.label, href: taskHref(course.slug, slug) },
];

---

<LabLayout
  title={data.title}
  titleSuffix={course.title}
  courseSlug={course.slug}
  description={data.summary}
  lang={data.lang}
  headings={headings}
>
  <Breadcrumbs items={crumbs} />

  <LabHeader
    eyebrow={`${data.eyebrow} · ЛР-${labNumber(lab)}`}
    title={data.title}
    summary={data.summary}
    handout={data.handout}
  />

  {
    data.goal && (
      <p class="task-goal">
        <strong>Мета практичної частини.</strong> {data.goal}
      </p>
    )
  }

  {
    data.acceptance.length > 0 && (
      <AcceptanceChecklist items={data.acceptance} />
    )
  }

  {
    data.mockup === "pricing" && (
      <figure class="task-preview">
        <MockupLightbox />
        <figcaption>Орієнтовний вигляд готової секції</figcaption>
      </figure>
    )
  }

  {
    data.mockup === "courtly" && (
      <figure class="task-preview">
        <CourtlyMockup />
        <figcaption>Макет сторінки Courtly на трьох ширинах viewport</figcaption>
      </figure>
    )
  }

  <article class="doc-content">
    <Content />
  </article>

  <nav class="task-back" aria-label="Lab">
    <a href={labHref(course.slug, slug)} rel="up"
      >← До лабораторної роботи №{labNumber(lab)}</a
    >
  </nav>
</LabLayout>

<style>
  /* The brief's "Мета практичної частини" box — a lead, not body copy, so it
     sits outside `.doc-content` and carries its own rule. */
  .task-goal {
    margin: 0 0 1.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-brand-blue);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  .task-goal strong {
    color: var(--foreground);
  }

  .task-preview {
    margin: 0 0 2.5rem;
  }

  .task-preview figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--muted-foreground);
  }

  .task-back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .task-back a {
    color: var(--brand-text);
    text-decoration: none;
  }

  .task-back a:hover {
    text-decoration: underline;
  }
</style>
