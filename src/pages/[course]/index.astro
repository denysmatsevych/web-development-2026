---
/**
 * Course landing page — the entry point from the course hub to its materials.
 */
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { getCourses, type Course } from "@/data/courses";
import { getSections } from "@/data/site";
import { withBase } from "@/lib/paths";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getCourses().map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

interface Props {
  course: Course;
}

const { course } = Astro.props;
const sections = getSections(course.slug);
---

<BaseLayout
  title={course.title}
  titleSuffix={course.title}
  description={course.description}
>
  <SiteHeader courseSlug={course.slug} />

  <main id="main-content" class="page" tabindex="-1">
    <a class="back-link" href={withBase("/")} lang="uk">
      <span aria-hidden="true">←</span>
      Усі курси
    </a>

    <section class="hero" aria-labelledby="page-title">
      <h1 id="page-title" class="hero__title" lang="en">{course.title}</h1>
      <p class="hero__lead" lang="en">{course.description}</p>
    </section>

    <ul class="sections" aria-label={`${course.title} materials`}>
      {
        sections.map((section) => (
          <li>
            <a href={withBase(section.href)} class="section glass-panel">
              <div class="section__top-panel">
                <span class="section__name" lang="en">{section.label}</span>
                <span class="section__arrow" aria-hidden="true">
                  →
                </span>
              </div>
              <span class="section__blurb" lang="en">{section.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <SiteFooter courseSlug={course.slug} />
</BaseLayout>

<style>
  .page {
    max-width: 72rem;
    margin-inline: auto;
    padding: 2rem 1rem 6rem;
  }

  @media (min-width: 640px) {
    .page {
      padding: 2.5rem 1.5rem 5rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.75rem;
    color: var(--brand-text);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--foreground);
  }

  .hero {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .hero__title {
    margin: 0 0 1rem;
    color: var(--foreground);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .hero__lead {
    max-width: 42rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .sections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .section__top-panel {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .section__name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .section__blurb {
    flex: 1;
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .section__arrow {
    font-size: 1.1rem;
    color: var(--brand-text);
    transition: transform 0.15s ease;
  }

  .section:hover .section__arrow {
    transform: translateX(0.2rem);
  }
</style>
