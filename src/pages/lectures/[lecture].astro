---
/**
 * Legacy lecture URL — redirect `/lectures/<lecture>/` to its course route.
 */
import { getCourses } from '@/data/courses';
import { getLectures } from '@/data/lectures';
import { withBase } from '@/lib/paths';

export function getStaticPaths() {
  const course = getCourses().find(({ slug }) => slug === 'web-development');
  if (!course) return [];

  return getLectures(course.slug).map((lecture) => ({
    params: { lecture: lecture.slug },
    props: {
      destination: withBase(`/${course.slug}/lectures/${lecture.slug}/`),
    },
  }));
}

return Astro.redirect(Astro.props.destination, 301);
---