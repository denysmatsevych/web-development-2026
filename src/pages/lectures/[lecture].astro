---
/**
 * Legacy lecture URL — redirect `/lectures/<lecture>/` to its course route.
 */
import { getLectures } from '@/data/lectures';
import { withBase } from '@/lib/paths';
import { LEGACY_COURSE } from '@/data/courses';

export function getStaticPaths() {
  return getLectures(LEGACY_COURSE).map((lecture) => ({
    params: { lecture: lecture.slug },
    props: {
      destination: withBase(`/${LEGACY_COURSE}/lectures/${lecture.slug}/`),
    },
  }));
}

return Astro.redirect(Astro.props.destination, 301);
---