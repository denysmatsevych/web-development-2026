---
/**
 * LabLayout — the reading shell for a single lab assignment:
 *
 *   SiteHeader (sticky)
 *   ┌──────────────────────┬───────────────┐
 *   │  <slot /> (article)  │  On this page │
 *   └──────────────────────┴───────────────┘
 *   SiteFooter
 *
 * A trimmed `DocsLayout`: labs have no Subject tabs and no curriculum sidebar,
 * so the shell is two columns, collapsing to one below `lg` with the ToC as a
 * sticky bar under the header (current section + dropdown list).
 *
 * `initDocs()` is still the right script — its sidebar setup bails when
 * `#docs-sidebar` is absent, leaving the ToC scrollspy/dropdown and the theme
 * toggle.
 *
 * Typography follows the handout PDFs — Montserrat headings, Inter text; see
 * `src/styles/lab.css`. The two webfonts load here, only on lab pages.
 */
import type { MarkdownHeading } from 'astro';

import OnThisPage from '@/components/OnThisPage.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/lab.css';

interface Props {
  /** Lab title — forwarded to `BaseLayout` (the page renders its own `<h1>`). */
  title: string;
  /** Lab summary → meta description. */
  description?: string;
  /** Body language — `'uk'` for the current handouts. */
  lang?: string;
  /** h2/h3 headings from `render(entry)` — feed the "on this page" rail. */
  headings?: MarkdownHeading[];
}

const { title, description, lang = 'uk', headings = [] } = Astro.props;

// Same non-blocking `media="print"` → `all` swap as BaseLayout's Roboto.
const fontHref =
  'https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400..700;1,400..700&family=Montserrat:wght@600..700&display=swap';
---

<BaseLayout title={title} description={description} lang={lang} ogType="article">
  <Fragment slot="head">
    <link id="font-lab" rel="stylesheet" href={fontHref} media="print" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>
    <script is:inline>
      (function () {
        var link = document.getElementById('font-lab');
        if (link) link.addEventListener('load', function () { link.media = 'all'; });
      })();
    </script>
  </Fragment>

  <div class="lab-page">
    <SiteHeader />

    <div class="lab-shell">
      <main id="main-content" class="area-main" tabindex="-1">
        <slot />
      </main>

      <div class="area-toc">
        <OnThisPage headings={headings} />
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>

<script>
  // ToC scrollspy + dropdown, theme toggle. The sidebar branch no-ops.
  import { initDocs } from '@/scripts/docs';

  initDocs();
</script>

<style>
  /* Matches DocsLayout: SiteHeader is 4rem. `--doc-scroll-offset` is the
     `.doc-content` heading `scroll-margin-top` (global.css) — below `lg` it
     also clears the sticky ToC bar. */
  .lab-page {
    --docs-header-h: 4rem;
    --doc-scroll-offset: 8.5rem;
  }

  .lab-shell {
    display: grid;
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    padding: 1.5rem 1rem 4rem;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'toc'
      'main';
  }

  .area-main {
    grid-area: main;
    min-width: 0;
  }

  /* Below `lg` the collapsed ToC rides under the header as a sticky bar. */
  .area-toc {
    grid-area: toc;
    position: sticky;
    top: calc(var(--docs-header-h) + 0.5rem);
    z-index: 20;
  }

  @media (min-width: 1024px) {
    .lab-page {
      --doc-scroll-offset: 6rem;
    }

    .lab-shell {
      padding-inline: 2rem;
      align-items: start;
      grid-template-columns: minmax(0, 1fr) 15rem;
      grid-template-areas: 'main toc';
    }

    .area-toc {
      top: calc(var(--docs-header-h) + 1rem);
      z-index: auto;
      align-self: start;
      max-height: calc(100dvh - var(--docs-header-h) - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
</style>
