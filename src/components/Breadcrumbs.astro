---
/**
 * Breadcrumbs — render a lightweight section trail for the current page.
 * The final crumb stays as the active page label, while earlier crumbs link
 * back to their parent sections.
 */
import { getLocale, useTranslations, type Locale } from '@/i18n';

interface CrumbPart { text: string; lang?: Locale }
interface Crumb { label: string; href: string; lang?: string; parts?: CrumbPart[] }

interface Props {
  /** Root first, current article last. */
  items: Crumb[];
  locale?: Locale;
}

const { items, locale: pageLocale } = Astro.props;
const locale = pageLocale ?? getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<nav class="breadcrumbs" aria-label={t.navigation.breadcrumb}>
  <ol>
    {
      items.map((crumb, i) => {
        const isLast = i === items.length - 1;
        return (
          <li>
            {isLast ? (
              <span aria-current="page" lang={crumb.lang === locale ? undefined : crumb.lang}>
                {crumb.parts
                  ? crumb.parts.map((part) => (
                      <span lang={part.lang === locale ? undefined : part.lang}>{part.text}</span>
                    ))
                  : crumb.label}
              </span>
            ) : (
              <a href={crumb.href} lang={crumb.lang === locale ? undefined : crumb.lang}>
                {crumb.parts
                  ? crumb.parts.map((part) => (
                      <span lang={part.lang === locale ? undefined : part.lang}>{part.text}</span>
                    ))
                  : crumb.label}
              </a>
            )}
            {!isLast && (
              <span class="breadcrumbs__sep" aria-hidden="true">
                ›
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: 0.8125rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumbs a {
    color: var(--muted-foreground);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--foreground);
    font-weight: 500;
  }

  .breadcrumbs__sep {
    color: var(--muted-foreground);
  }
</style>
