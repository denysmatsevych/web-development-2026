---
/**
 * SiteHeader — sticky, institute-styled top bar (ported look from
 * `website_ao` Header, minus React / the site menu).
 *
 * Layout: wordmark → home · in-site "Lectures" / "Labs" section links (from
 * `src/data/site.ts`) · disabled `EN` language-switcher placeholder ·
 * `ThemeToggle`.
 *
 * Height is a fixed 4rem to match `--header-h` in `LabLayout` (the sticky
 * offset for the ToC rail).
 */
import ThemeToggle from '@/components/ThemeToggle.astro';
import { sections, site } from '@/data/site';
import { withBase } from '@/lib/paths';

const home = withBase('/');

const crossLinks = sections.map((section) => ({
  label: section.label,
  href: withBase(section.href),
}));
---

<header
  class="sticky top-0 z-30 h-16 border-b border-border bg-background/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-full max-w-[100rem] items-center gap-3 px-4 sm:px-6">
    <a
      href={home}
      class="mr-auto flex shrink-0 items-center gap-2 font-semibold tracking-tight text-foreground"
    >
      <span class="inline-block size-2.5 rounded-full bg-brand-blue" aria-hidden="true"></span>
      {site.name}
    </a>

    <nav class="hidden items-center gap-1 sm:flex" aria-label="Course sections">
      {
        crossLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <span class="mx-1 hidden h-5 w-px bg-border sm:block" aria-hidden="true"></span>

    <span
      class="hidden cursor-not-allowed select-none rounded-lg border border-border px-2 py-1 text-xs font-medium text-muted-foreground sm:inline-block"
      aria-disabled="true"
      title="English only for now — a language switcher lands later"
    >
      EN
    </span>

    <ThemeToggle />
  </div>
</header>
