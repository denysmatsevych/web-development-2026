---
/**
 * OnThisPage — in-page h2/h3 anchor list for the current article, from the
 * `headings` that `render(entry)` returns (Astro stamps the `id`s).
 *
 * One `<details>`, two presentations:
 *   - `lg+`: an always-visible sticky right rail (placement from the layout).
 *     The list shows whatever `open` says and scrolls on its own when it
 *     outgrows the viewport.
 *   - below `lg`: a compact bar the layout pins under the header. The summary
 *     names the section being read (`[data-toc-current]`); opening it drops the
 *     list down as an overlay, so the article never shifts.
 *
 * `src/scripts/docs.ts` scroll-spies `.doc-content :is(h2,h3)`, toggles
 * `.is-active` on the matching `[data-toc-link]`, fills `[data-toc-current]`,
 * and closes the dropdown on a link pick / `Esc` / outside click. Renders
 * nothing when there are no headings.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 && (
    <details class="on-this-page">
      <summary class="on-this-page__summary">
        <span class="on-this-page__summary-label">On this page</span>
        <span class="on-this-page__current" data-toc-current />
      </summary>

      <div class="on-this-page__body">
        <p class="on-this-page__label" aria-hidden="true">
          On this page
        </p>
        <nav aria-label="On this page">
          <ul class="on-this-page__list">
            {items.map((heading) => (
              <li
                class:list={[
                  'on-this-page__item',
                  { 'on-this-page__item--sub': heading.depth === 3 },
                ]}
              >
                <a href={`#${heading.slug}`} class="on-this-page__link" data-toc-link>
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </details>
  )
}

<style>
  .on-this-page {
    position: relative;
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    /* Opaque enough to read over the article scrolling under the sticky bar. */
    background: color-mix(in oklab, var(--background) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .on-this-page__summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--foreground);
  }

  .on-this-page__summary::-webkit-details-marker {
    display: none;
  }

  .on-this-page__summary-label {
    flex-shrink: 0;
  }

  /* Section being read — filled by docs.ts, truncated to one line. */
  .on-this-page__current {
    min-width: 0;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 400;
    color: var(--muted-foreground);
  }

  .on-this-page__current:empty {
    display: none;
  }

  .on-this-page__summary::after {
    content: '';
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    margin: -0.25rem 0 0 auto;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  .on-this-page[open] .on-this-page__summary::after {
    margin-top: 0.25rem;
    transform: rotate(-135deg);
  }

  /* The open list drops down over the article instead of pushing it. */
  .on-this-page__body {
    position: absolute;
    top: calc(100% + 0.375rem);
    inset-inline: -1px;
    max-height: min(65dvh, 32rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem 0.4rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.45);
  }

  .on-this-page__label {
    display: none;
  }

  .on-this-page__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .on-this-page__item {
    margin: 0.1rem 0;
  }

  .on-this-page__item--sub {
    padding-left: 0.9rem;
  }

  .on-this-page__link {
    display: block;
    padding: 0.25rem 0.5rem;
    border-left: 2px solid transparent;
    color: var(--muted-foreground);
    text-decoration: none;
    line-height: 1.4;
  }

  .on-this-page__link:hover {
    color: var(--foreground);
  }

  .on-this-page__link.is-active {
    color: var(--foreground);
    font-weight: 600;
    border-left-color: var(--color-brand-blue);
  }

  /* lg+: plain sticky rail — no card, summary hidden, list always shown. */
  @media (min-width: 1024px) {
    .on-this-page {
      border: 0;
      border-radius: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .on-this-page__summary {
      display: none;
    }

    /* A closed <details> hides its `::details-content` slot in current engines;
       the `!important` pair on the body covers engines that predate it. */
    .on-this-page::details-content {
      content-visibility: visible;
    }

    .on-this-page__body {
      position: static;
      display: block !important;
      content-visibility: visible !important;
      max-height: none;
      overflow: visible;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .on-this-page__label {
      display: block;
      margin: 0 0 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted-foreground);
    }

    .on-this-page__list {
      border-left: 1px solid var(--border);
    }

    .on-this-page__link {
      margin-left: -1px;
    }
  }
</style>
