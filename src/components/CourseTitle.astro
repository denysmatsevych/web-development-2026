---
import type { CourseTitlePart } from '@/data/courses';
import type { Locale } from '@/i18n';

interface Props {
  parts: CourseTitlePart[];
  locale: Locale;
}

const { parts, locale } = Astro.props;
---

{parts.map((part) => {
  const lang = part.lang ?? locale;
  return <span lang={lang === locale ? undefined : lang}>{part.text}</span>;
})}
