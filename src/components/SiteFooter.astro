---
/**
 * SiteFooter — hierarchical course navigation, a contact link, and a
 * copyright line. Flat `--color-footer-bg`, no gooey / particle animation.
 */
import {
  getCourseNavTitle,
  getCourseNavTitleLang,
  getCourses,
} from "@/data/courses";
import { getSections, site } from "@/data/site";
import { getLocale, localeHref, useTranslations, type Locale } from "@/i18n";

interface Props {
  courseSlug?: string;
  locale?: Locale;
}

const { courseSlug, locale: pageLocale } = Astro.props;
const locale = pageLocale ?? getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
const courses = getCourses();
---

<footer class="bg-footer-bg text-pure-white">
  <div class="mx-auto max-w-[100rem] px-4 py-8 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2">
      <nav aria-label={t.navigation.courses}>
        <p
          class="text-xs font-semibold uppercase tracking-widest text-pure-white/50"
        >
          {t.navigation.courses}
        </p>
        <ul class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
          {
            courses.map((course) => (
              <li>
                <a
                  href={localeHref(locale, `/${course.slug}/`)}
                  class="inline-flex items-center gap-1 text-base font-bold text-pure-white/80 transition-colors hover:text-brand-blue-light"
                  aria-current={course.slug === courseSlug ? 'location' : undefined}
                  lang={getCourseNavTitleLang(course, locale)}
                >
                  {getCourseNavTitle(course, locale)}
                </a>
                <ul class="mt-2 space-y-2">
                  {getSections(course.slug, locale).map((section) => (
                    <li>
                      <a
                        href={localeHref(locale, section.href)}
                        class="inline-flex items-center gap-1 text-sm text-pure-white/60 transition-colors hover:text-brand-blue-light"
                      >
                        {section.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:text-right">
        <p
          class="text-xs font-semibold uppercase tracking-widest text-pure-white/50"
        >
          {t.navigation.contact}
        </p>
        <p class="mt-4">
          <a
            href={site.contactUrl}
            rel="noopener noreferrer"
            class="text-sm text-pure-white/80 transition-colors hover:text-brand-blue-light"
          >
            {site.contactLabel}
          </a>
        </p>
      </div>
    </div>

    <p
      class="mt-6 border-t border-pure-white/10 pt-4 text-xs text-pure-white/50"
    >
      © {year}
      {" "}
      {t.site.name}
    </p>
  </div>
</footer>
